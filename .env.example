# Підключення до PostgreSQL.
# Значення нижче відповідає docker-compose.yml у цьому репозиторії.
DATABASE_URL=postgresql+psycopg://expense:expense@localhost:5434/expense_approval

# Ключ OpenAI для AI-підказки погоджувачу.
# Без нього застосунок працює повністю — просто не показує AI-блок.
OPENAI_API_KEY=sk-...

# --- необов'язкове ---
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT=8

# Скільки днів живе сесія після входу
SESSION_TTL_DAYS=7

# Захист від перебору пароля: скільки невдалих спроб і на скільки блокувати
MAX_LOGIN_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
